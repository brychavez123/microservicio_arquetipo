# Nombre del contenedor y del repositorio ECR
SERVICE_NAME=${artifactId}
# El contenedor queda en 127.0.0.1:HOST_PORT; Nginx lo publica en el puerto 80
HOST_PORT=${puerto}
CONTAINER_PORT=${puerto}
# Prueba dentro de la EC2
HEALTH_PATH=/actuator/health
# Prueba desde internet a través de Nginx (agrega la ruta de este servicio en ec2/foro-ec2-stack.yml)
PUBLIC_SMOKE_PATH=/api/info
NEEDS_DB=true
